# Kopiere diese Datei an einen Ort AUSSERHALB dieses Repo-Ordners (z.B. neben
# docker-compose.yml, aber .gitignore-geschuetzt) und trage dort echte Werte
# ein. Der Pfad zu dieser Datei kommt in .env als SECRETS_FILE. Format:
# KEY=VALUE, # leitet Kommentarzeilen ein, keine Anfuehrungszeichen um Werte.

# SuperAdmin-Passwort deines Trackmania-Dedicated-Servers (dedicated_cfg.txt)
SUPERADMIN_PASSWORD=

# Trackmania-Account-Logins, die Admin-Rechte im Controller bekommen sollen
# (kommagetrennt, z.B. ABCDEFGHijklmnop123,ZYXWvutsrq456). Login findest du
# z.B. auf trackmania.io/#/players.
ADMIN_LOGINS=

# Telegram-Bot-Token von @BotFather + Chat-ID der Gruppe (siehe SETUP.md)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: zweiter Bot-Token fuer Testlaeufe (TELEGRAM_TEST_BOT=true), damit
# der Produktiv-Bot beim Testen nicht doppelt pollt
TELEGRAM_TOKEN_TEST=

# Passwort-Hash fuers Website-Admin-Dashboard (NICHT das SuperAdmin-Passwort
# oben) -- erzeugen mit: php -r "echo password_hash('DEIN_PASSWORT', PASSWORD_DEFAULT);"
ADMIN_DASHBOARD_PASSWORT_HASH=

# Optional, nur falls du das KI-Analyse-Beta-Feature nutzen willst (siehe
# README) -- verursacht echte Kosten bei Anthropic. Leer lassen = Feature
# bleibt ueber KI_AUS=true in .env ohnehin deaktiviert.
ANTHROPIC_API_KEY=
