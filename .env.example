# Kopiere diese Datei nach .env und passe sie an. Siehe SETUP.md fuer die
# vollstaendige Anleitung, CONFIGURATION.md fuer die Referenz aller Variablen.

# Mongo-Datenbankname (im Live-Betrieb ueblicherweise "nextcontrol")
MONGO_DB=nextcontrol

# Host/IP des Trackmania-Dedicated-Servers. Der Dedicated Server selbst laeuft
# NICHT in Docker (proprietaeres Windows/Ubisoft-Binary) -- der Controller-
# Container muss ihn ueber das Netz erreichen. Unter Docker Desktop
# (Windows/Mac) funktioniert meist "host.docker.internal", wenn der Server auf
# demselben Rechner laeuft. Unter Linux die LAN-IP des Rechners verwenden.
TM_SERVER_HOST=host.docker.internal

# XML-RPC-Port des Dedicated Servers (dedicated_cfg.txt, <xmlrpc_port>)
TRACKMANIA_PORT=5555

# Absoluter Pfad zum UserData/Maps-Ordner deines Dedicated Servers (wird in
# den Controller-Container gemountet, damit Map-Voting/Cup-Feature Maps lesen
# und MatchSettings schreiben koennen).
TM_USERDATA_MAPS_DIR=/pfad/zu/deinem/TrackmaniaServer/UserData/Maps

# Absoluter Pfad zur secrets.env (siehe secrets.env.example) -- bewusst
# AUSSERHALB dieses Repo-Ordners aufbewahren.
SECRETS_FILE=/pfad/zu/deiner/secrets.env

# Port, unter dem die Website lokal erreichbar ist (http://localhost:<PORT>)
WEBSITE_PORT=8080

# KI-Analyse-Features (optionales Beta-Feature, verursacht echte Kosten ueber
# einen eigenen Anthropic-API-Key, siehe secrets.env.example). Default AUS.
KI_AUS=true
NACHRICHTEN_KI_AUS=true

# Cup-Turniersystem (Beta-Feature): /cup-Telegram-Befehle im Haupt-Controller
# freischalten. Default AUS.
CUP_TELEGRAM_AKTIV=false
